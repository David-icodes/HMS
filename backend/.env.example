# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hms

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# CORS (comma separated list of allowed origins)
CLIENT_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000

# Super admin bootstrap credentials (used by seed script)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@hms.com
SUPER_ADMIN_MOBILE=9000000000
SUPER_ADMIN_PASSWORD=Admin@123

# Cloudinary (for CMS image uploads). Fill in real values in .env.
# API secret is never exposed to the frontend.
CLOUDINARY_CLOUD_NAME=HMS
CLOUDINARY_API_KEY=737352984613217
CLOUDINARY_API_SECRET=oZiqD-0BrfZCvu4iM8C81mtQN9k
# Optional root folder inside Cloudinary for uploaded images
CLOUDINARY_FOLDER=urmila-raj-hospital
